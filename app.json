{
  "expo": {
    "name": "HoloWare Baseline",
    "slug": "holoware-baseline",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "holoware",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.holoware.baseline"
    },
    "android": {
      "package": "com.holoware.baseline"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "ScanBan necesita acceso a la cámara para escanear códigos de barras de los productos en depósito."
        }
      ],
      "expo-sqlite"
    ]
  }
}
