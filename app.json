{
  "expo": {
    "name": "Phone-Ware",
    "slug": "phone-ware",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.phoneware.deposito"
    },
    "android": {
      "package": "com.phoneware.deposito"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Phone-Ware necesita acceso a la cámara para escanear códigos de barras de los productos en depósito."
        }
      ],
      "expo-sqlite"
    ]
  }
}
