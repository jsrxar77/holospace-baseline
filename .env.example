# Copiar a .env (no versionar). Nunca commitear valores reales.
HW_PORT=3001
# Obligatorio en produccion: minimo 32 caracteres aleatorios (openssl rand -hex 32)
JWT_SECRET=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
NODE_ENV=development
# Produccion: origenes permitidos para la API, separados por coma
CORS_ORIGINS=
LOGIN_RATE_MAX=10
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
# Usuario de SOLO LECTURA para el MCP postgres (.mcp.json)
HOLOSPACE_DB_URL=postgresql://holospace_readonly:CAMBIAR@localhost:5434/holospace_db
